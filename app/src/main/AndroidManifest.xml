<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/logo_banksampah"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_banksampah"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.BankSampah"
        tools:targetApi="31">
        <activity
            android:name=".ui.penarikan.PenarikanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.berita.BeritaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.notifikasi.NotifikasiActivity"
            android:exported="false" />
        <activity
            android:name=".ui.riwayat.RiwayatPenyetoranActivity"
            android:exported="false" />
        <activity
            android:name=".ui.riwayat.RiwayatPenarikanActivity"
            android:exported="false" />
        <activity
            android:name=".ui.detail.DetailBeritaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.detail.DetailKatalogActivity"
            android:exported="false" />
        <activity
            android:name=".ui.StartActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ui.autentikasi.register.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.autentikasi.login.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>