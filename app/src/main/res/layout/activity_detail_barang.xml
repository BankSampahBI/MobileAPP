<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollViewDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gambar Barang -->
        <ImageView
            android:id="@+id/ivDetailFoto"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:contentDescription="Foto Barang"
            android:background="@color/dark_green" />

        <!-- Nama Barang -->
        <TextView
            android:id="@+id/tvDetailNamaBarang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nama Barang"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <!-- Harga -->
        <TextView
            android:id="@+id/tvDetailHarga"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp 0"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:layout_marginTop="8dp" />

        <!-- Deskripsi -->
        <TextView
            android:id="@+id/tvDetailDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi lengkap barang..."
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

        <!-- Tombol Beli -->
        <Button
            android:id="@+id/btnBeli"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Beli Sekarang"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/black"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>
