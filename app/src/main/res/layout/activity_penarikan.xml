<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wgreen"
    android:padding="20dp"
    tools:context=".ui.penarikan.PenarikanActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardForm"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Judul -->
            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajukan Penarikan"
                android:textSize="22sp"
                android:textColor="@color/orange"
                android:fontFamily="@font/poppins_bold"
                android:layout_gravity="center_horizontal"
                android:paddingBottom="16dp" />

            <!-- Card Saldo -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSaldo"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                app:cardBackgroundColor="@color/mountain_green"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/labelSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Saldo Kamu"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_saldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rp. 200.000.000"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:fontFamily="@font/poppins_bold"
                        app:layout_constraintStart_toStartOf="@id/labelSaldo"
                        app:layout_constraintTop_toBottomOf="@id/labelSaldo" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*Kamu bisa menarik saldomu kapan saja"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:fontFamily="@font/poppins_regular"
                        app:layout_constraintStart_toStartOf="@id/tv_saldo"
                        app:layout_constraintTop_toBottomOf="@id/tv_saldo" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

            <!-- Input Jumlah Penarikan -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layout_input"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_jumlah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Masukkan jumlah saldo yang ingin ditarik"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:fontFamily="@font/poppins_regular" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp" />

            <!-- Tombol Ajukan -->
            <Button
                android:id="@+id/btn_ajukan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajukan Penarikan"
                android:backgroundTint="@color/pale_green"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_medium"
                android:paddingVertical="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_submit" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
